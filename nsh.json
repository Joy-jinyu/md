{
  "name": "Pairdown",
  "id": "site.pairwise.md",
  "version": "1.0.0",
  "build": 1,
  "icon": {
    "macos": "assets/icon/icon-macos.png",
    "web": "assets/icon/icon.png"
  },
  "theme": "theme.json",
  "tailwind": {
    "ease": {
      "settle": [0.22, 1, 0.36, 1]
    }
  },
  "capabilities": {
    "openUrl": {
      "schemes": ["http", "https", "mailto"]
    },
    "application": true,
    "picker": true,
    "clipboard": true,
    "homeDir": true,
    "fs": {
      "read": ["${homeDir}/Downloads", "${homeDir}/Documents/Pairdown"],
      "write": ["${homeDir}/Downloads", "${homeDir}/Documents/Pairdown"]
    },
    "webview": { "hosts": [] },
    "network": {
      "hosts": ["api.github.com", "github.com", "gist.githubusercontent.com"],
      "http": [{ "host": "*", "methods": ["GET"] }]
    }
  },
  "fileTypes": [{ "name": "Markdown", "extensions": ["md", "markdown"], "role": "editor" }],
  "web": {
    "base": "/",
    "connect": ["127.0.0.1:7341"]
  }
}
