      "accent-foreground": "var(--strong)",
      "hover": "rgba(255,255,255,0.05)",
      "pressed": "rgba(255,255,255,0.09)",
      "border": "rgba(255,255,255,0.08)",
      "border-strong": "rgba(255,255,255,0.14)",
      "input": "var(--border-strong)",
