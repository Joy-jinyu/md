      "popover": "#16181d",
      "popover-foreground": "var(--foreground)",
      "primary": "#00b8b8",
      "primary-foreground": "#001414",
      "secondary": "rgba(255,255,255,0.06)",
      "secondary-foreground": "var(--strong)",
      "muted": "rgba(255,255,255,0.05)",
